{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morethan.local/contracts/federation-descriptor-v1.schema.json",
  "title": "Federation descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "role",
    "platform_ref_namespace",
    "providers",
    "scenario_aliases",
    "canonical_objects"
  ],
  "properties": {
    "repository": { "type": "string", "minLength": 1 },
    "role": {
      "enum": ["contract_owner", "platform_host", "scenario_owner"]
    },
    "platform_ref_namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "manifest_module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "export"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "export": { "type": "string", "minLength": 1 }
      }
    },
    "manifest": { "type": "object" },
    "providers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "scenario_aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "target", "allows_new_writes"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "allows_new_writes": { "const": false }
        }
      }
    },
    "canonical_objects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "owner"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "role": { "const": "scenario_owner" } },
        "required": ["role"]
      },
      "then": {
        "anyOf": [
          { "required": ["manifest"] },
          { "required": ["manifest_module"] }
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["manifest"] },
            { "required": ["manifest_module"] }
          ]
        }
      }
    }
  ]
}
