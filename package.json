{
  "name": "my-workflow-base",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck:contracts": "pnpm --filter @host/workflow-contracts typecheck",
    "typecheck:runtime": "pnpm --filter @host/workflow-runtime typecheck",
    "typecheck:scenario": "pnpm --filter @host/scenario-module-example typecheck",
    "typecheck": "pnpm typecheck:contracts && pnpm typecheck:runtime && pnpm typecheck:scenario",
    "test:runtime": "pnpm --filter @host/workflow-runtime test",
    "test:scenario": "pnpm --filter @host/scenario-module-example test",
    "test:conformance": "pnpm --filter @workflow-base/conformance test",
    "test:workbench": "pnpm --dir templates/web-workbench test",
    "test": "pnpm test:runtime && pnpm test:scenario && pnpm test:conformance && pnpm test:workbench",
    "hash:workflow-contract-source": "node conformance/scripts/compute-workflow-contract-source-hash.mjs",
    "check:workflow-contract-source": "node conformance/scripts/compute-workflow-contract-source-hash.mjs --check conformance/workflow-contract-source-lock.json",
    "check:ui-tokens": "node templates/web-workbench/tokens/emit.mjs --check",
    "check:consumer-boundaries": "node conformance/scripts/check-consumer-boundaries.mjs",
    "semantic-lint": "node conformance/scripts/semantic-lint.mjs",
    "lint:canonical-refs": "node conformance/scripts/canonical-ref-lint.mjs templates/host-runtime/packages/workflow-contracts/src templates/host-runtime/packages/workflow-runtime/src templates/scenario-module/src templates/scenario-module/scenario.manifest.yaml",
    "verify:integration-lock": "node conformance/scripts/verify-integration-lock.mjs",
    "verify:workflow-contracts": "pnpm typecheck && pnpm --dir templates/web-workbench typecheck && pnpm lint:canonical-refs && pnpm check:consumer-boundaries && pnpm test && pnpm check:workflow-contract-source && pnpm check:ui-tokens"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.5"
  }
}
