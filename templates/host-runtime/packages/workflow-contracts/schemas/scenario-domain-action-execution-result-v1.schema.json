{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morethan.local/contracts/scenario-domain-action-execution-result-v1.schema.json",
  "title": "ScenarioDomainActionExecutionResultV1",
  "description": "Server-only execution result with persisted outcome separated from invocation disposition.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": { "enum": ["committed", "not_committed", "outcome_unknown"] },
    "disposition": { "enum": ["executed", "replayed"] },
    "business_outcome": { "enum": ["applied", "already_satisfied"] },
    "execution_ref": { "$ref": "canonical-ref-v1.schema.json" },
    "output_refs": { "$ref": "#/$defs/canonicalRefs" },
    "handoff_request_snapshots": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/handoffSnapshot" } },
    "decision": { "enum": ["invalid_request", "request_conflict", "rate_limited"] },
    "safe_reason": { "$ref": "scenario-safe-reason-v1.schema.json" }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "disposition", "business_outcome", "execution_ref", "output_refs", "handoff_request_snapshots"],
      "properties": {
        "status": { "const": "committed" },
        "disposition": { "enum": ["executed", "replayed"] },
        "business_outcome": { "enum": ["applied", "already_satisfied"] },
        "execution_ref": { "$ref": "canonical-ref-v1.schema.json" },
        "output_refs": { "$ref": "#/$defs/canonicalRefs" },
        "handoff_request_snapshots": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/handoffSnapshot" } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "decision", "safe_reason"],
      "properties": {
        "status": { "const": "not_committed" },
        "decision": { "enum": ["invalid_request", "request_conflict", "rate_limited"] },
        "safe_reason": { "$ref": "scenario-safe-reason-v1.schema.json" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "safe_reason"],
      "properties": {
        "status": { "const": "outcome_unknown" },
        "safe_reason": { "$ref": "scenario-safe-reason-v1.schema.json" }
      }
    }
  ],
  "$defs": {
    "canonicalRefs": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "canonical-ref-v1.schema.json" }
    },
    "handoffSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "handoffKey", "requestedPurpose"],
      "properties": {
        "requestId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$" },
        "handoffKey": { "$ref": "#/$defs/machineKey" },
        "requestedPurpose": { "$ref": "#/$defs/machineKey" },
        "sourceContextRefs": { "$ref": "#/$defs/canonicalRefs" },
        "sourceArtifactRefs": { "$ref": "#/$defs/canonicalRefs" },
        "expiresAt": { "$ref": "#/$defs/canonicalInstant" }
      }
    },
    "machineKey": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9._:-]*$" },
    "canonicalInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
