{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morethan.local/contracts/scenario-domain-action-submit-echo-v1.schema.json",
  "title": "ScenarioDomainActionSubmitEchoV1",
  "description": "The exact four-field client-authored submit echo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["submit_version", "submit_token", "confirmation", "client_mutation_id"],
  "properties": {
    "submit_version": { "const": 1 },
    "submit_token": { "type": "string", "minLength": 32, "maxLength": 512, "pattern": "^[A-Za-z0-9_-]+$" },
    "confirmation": { "const": "confirmed" },
    "client_mutation_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$" }
  }
}
