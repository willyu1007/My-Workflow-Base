{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morethan.local/contracts/scenario-protected-display-lease-v1.schema.json",
  "title": "ScenarioProtectedDisplayLeaseV1",
  "description": "Short no-store lease for foreground display of separately transported protected plaintext.",
  "type": "object",
  "additionalProperties": false,
  "required": ["display_lease_version", "cache_policy", "issued_at", "expires_at"],
  "properties": {
    "display_lease_version": { "const": 1 },
    "cache_policy": { "const": "no_store" },
    "issued_at": { "$ref": "#/$defs/canonicalInstant" },
    "expires_at": { "$ref": "#/$defs/canonicalInstant" }
  },
  "$defs": {
    "canonicalInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
