{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morethan.local/contracts/scenario-private-invocation-v1.schema.json",
  "title": "ScenarioPrivateInvocationV1",
  "description": "Signed JSON body for a private Host-to-scenario invocation. Detached signatures and service credentials are transport metadata outside this object.",
  "type": "object",
  "additionalProperties": false,
  "required": ["invocation_version", "contract_version", "contract_hash", "issuer", "assertion_audience", "caller_binding", "principal", "route", "request", "operation"],
  "properties": {
    "invocation_version": { "const": 1 },
    "contract_version": { "const": 1 },
    "contract_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "issuer": { "$ref": "#/$defs/machineKey" },
    "assertion_audience": { "$ref": "#/$defs/machineKey" },
    "caller_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caller_subject"],
      "properties": {
        "caller_subject": { "$ref": "#/$defs/opaqueId" }
      }
    },
    "principal": { "$ref": "scenario-human-principal-v1.schema.json" },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_key", "endpoint_key", "method", "ingress"],
      "properties": {
        "scenario_key": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9-]*$" },
        "endpoint_key": { "$ref": "#/$defs/machineKey" },
        "method": { "const": "POST" },
        "ingress": { "$ref": "scenario-ingress-surface-v1.schema.json" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "correlation_id", "issued_at", "expires_at", "nonce"],
      "properties": {
        "request_id": { "$ref": "#/$defs/opaqueId" },
        "correlation_id": { "$ref": "#/$defs/opaqueId" },
        "trace_id": { "$ref": "#/$defs/opaqueId" },
        "issued_at": { "$ref": "#/$defs/canonicalInstant" },
        "expires_at": { "$ref": "#/$defs/canonicalInstant" },
        "nonce": { "type": "string", "minLength": 32, "maxLength": 256, "pattern": "^[A-Za-z0-9_-]+$" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_key", "input_schema_version", "input"],
      "properties": {
        "operation_key": { "$ref": "#/$defs/machineKey" },
        "input_schema_version": { "type": "integer", "minimum": 1 },
        "input": true
      }
    }
  },
  "$defs": {
    "machineKey": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9._:-]*$" },
    "opaqueId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$" },
    "canonicalInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
