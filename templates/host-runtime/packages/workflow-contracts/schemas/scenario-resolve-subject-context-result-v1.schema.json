{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morethan.local/contracts/scenario-resolve-subject-context-result-v1.schema.json",
  "title": "ResolveScenarioSubjectContextResultV1",
  "description": "Closed current owner resolution result for one opaque context locator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status"],
  "properties": {
    "status": { "enum": ["resolved", "context_changed", "unavailable"] },
    "context": { "$ref": "scenario-subject-context-option-v1.schema.json" },
    "resolved_at": { "$ref": "#/$defs/canonicalInstant" },
    "safe_reason": { "$ref": "scenario-safe-reason-v1.schema.json" }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["context", "resolved_at"],
      "properties": {
        "status": { "const": "resolved" },
        "context": true,
        "resolved_at": true
      },
      "minProperties": 3,
      "maxProperties": 3
    },
    {
      "type": "object",
      "required": ["safe_reason"],
      "properties": {
        "status": { "const": "context_changed" },
        "safe_reason": true
      },
      "minProperties": 2,
      "maxProperties": 2
    },
    {
      "type": "object",
      "required": ["safe_reason"],
      "properties": {
        "status": { "const": "unavailable" },
        "safe_reason": true
      },
      "minProperties": 2,
      "maxProperties": 2
    }
  ],
  "$defs": {
    "canonicalInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
