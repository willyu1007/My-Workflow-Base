{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morethan.local/contracts/scenario-protected-content-read-locator-v1.schema.json",
  "title": "ScenarioProtectedContentReadLocatorV1",
  "description": "Ephemeral foreground protected-content control; not a URL, canonical ref or authorization grant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protected_read_locator_version",
    "protected_content_ref",
    "content_kind",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "protected_read_locator_version": { "const": 1 },
    "protected_content_ref": { "$ref": "#/$defs/opaqueRef" },
    "content_kind": { "$ref": "#/$defs/machineKey" },
    "issued_at": { "$ref": "#/$defs/canonicalInstant" },
    "expires_at": { "$ref": "#/$defs/canonicalInstant" }
  },
  "$defs": {
    "opaqueRef": {
      "type": "string",
      "minLength": 32,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "machineKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._:-]*$"
    },
    "canonicalInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
