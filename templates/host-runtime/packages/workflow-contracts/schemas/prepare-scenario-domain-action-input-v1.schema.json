{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morethan.local/contracts/prepare-scenario-domain-action-input-v1.schema.json",
  "title": "PrepareScenarioDomainActionInputV1",
  "description": "Zero-effect prepare request using the I1-C owner-issued target locator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["prepare_version", "action_key", "target_ref", "action_input"],
  "properties": {
    "prepare_version": { "const": 1 },
    "action_key": { "$ref": "#/$defs/machineKey" },
    "target_ref": { "type": "string", "minLength": 32, "maxLength": 512, "pattern": "^[A-Za-z0-9_-]+$" },
    "expected_version": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$" },
    "action_input": { "type": "object" }
  },
  "$defs": {
    "machineKey": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9._:-]*$" }
  }
}
