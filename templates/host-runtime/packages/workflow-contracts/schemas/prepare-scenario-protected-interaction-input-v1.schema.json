^A-Za-z0-9]*(?:[Aa][^A-Za-z0-9]*[Rr][^A-Za-z0-9]*[Rr][^A-Za-z0-9]*[Ii][^A-Za-z0-9]*[Ee][^A-Za-z0-9]*[Rr]|[Oo][^A-Za-z0-9]*[Nn][^A-Za-z0-9]*[Tt][^A-Za-z0-9]*[Ee][^A-Za-z0-9]*[Nn][^A-Za-z0-9]*[Tt][^A-Za-z0-9]*[Rr][^A-Za-z0-9]*[Ee][^A-Za-z0-9]*[Ff])))|[Ss][^A-Za-z0-9]*[Uu][^A-Za-z0-9]*[Mm][^A-Za-z0-9]*[Mm][^A-Za-z0-9]*[Aa][^A-Za-z0-9]*[Rr][^A-Za-z0-9]*[Yy]|[Ww][^A-Za-z0-9]*[Rr][^A-Za-z0-9]*[Aa][^A-Za-z0-9]*[Pp][^A-Za-z0-9]*[Pp][^A-Za-z0-9]*[Ee][^A-Za-z0-9]*[Dd][^A-Za-z0-9]*[Kk][^A-Za-z0-9]*[Ee][^A-Za-z0-9]*[Yy])"
      }
    },
    "bodyFreeObject": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/forbiddenBodyField" },
      "additionalProperties": { "$ref": "#/$defs/bodyFreeValue" }
    },
    "bodyFreeValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/bodyFreeValue" }
        },
        { "$ref": "#/$defs/bodyFreeObject" }
      ]
    }
  }
}
