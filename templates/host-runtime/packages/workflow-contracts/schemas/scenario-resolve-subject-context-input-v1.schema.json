{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morethan.local/contracts/scenario-resolve-subject-context-input-v1.schema.json",
  "title": "ResolveScenarioSubjectContextInputV1",
  "description": "Scenario-private revalidation input for one owner-issued subject-context locator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider_version", "subject_context_ref"],
  "properties": {
    "provider_version": { "const": 1 },
    "subject_context_ref": { "$ref": "#/$defs/opaqueLocator" },
    "known_context_version": { "$ref": "#/$defs/opaqueVersion" }
  },
  "$defs": {
    "opaqueLocator": {
      "type": "string",
      "minLength": 32,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "opaqueVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$"
    }
  }
}
