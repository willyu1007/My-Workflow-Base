{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morethan.local/contracts/scenario-safe-text-v1.schema.json",
  "title": "ScenarioSafeTextV1",
  "description": "Owner-localized bounded plain text. Scenario registry and disclosure checks remain owner responsibilities.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "value", "locale"],
  "properties": {
    "kind": { "const": "plain_text" },
    "value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "allOf": [
        { "not": { "pattern": "[\\u0000-\\u001F\\u007F-\\u009F]" } },
        { "not": { "pattern": "<\\/?[A-Za-z][^>]*>|<!--|-->" } },
        { "not": { "pattern": "(?:[Hh][Tt][Tt][Pp][Ss]?|[Ff][Tt][Pp]):\\/\\/|[Mm][Aa][Ii][Ll][Tt][Oo]:|[Ww][Ww][Ww]\\." } },
        { "not": { "pattern": "(?:^|\\n)\\s{0,3}(?:#{1,6}\\s|>\\s|[-*+]\\s|[0-9]+\\.\\s)|!?\\[[^\\]]*\\]\\([^)]+\\)|\\*\\*|__|~~|`" } },
        { "not": { "pattern": "\\{\\{[^}]*\\}\\}|\\$\\{[^}]*\\}|\\{[A-Za-z][A-Za-z0-9_.-]*\\}" } },
        { "not": { "pattern": "\\b(?:[Ss][Tt][Aa][Cc][Kk] [Tt][Rr][Aa][Cc][Ee]|[Ss][Qq][Ll][Ss][Tt][Aa][Tt][Ee]|[Pp][Oo][Ss][Tt][Gg][Rr][Ee][Ss](?:[Qq][Ll])?|[Pp][Rr][Ii][Ss][Mm][Aa]|[Dd][Aa][Tt][Aa][Bb][Aa][Ss][Ee] [Ee][Rr][Rr][Oo][Rr]|[Pp][Rr][Oo][Vv][Ii][Dd][Ee][Rr] [Ee][Rr][Rr][Oo][Rr]|[Ii][Nn][Tt][Ee][Rr][Nn][Aa][Ll] (?:[Ee][Xx][Cc][Ee][Pp][Tt][Ii][Oo][Nn]|[Rr][Ee][Aa][Ss][Oo][Nn]))\\b" } }
      ]
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-[A-Za-z0-9]{5,8})*$"
    }
  }
}
