{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morethan.local/contracts/scenario-domain-action-current-result-v1.schema.json",
  "title": "ScenarioDomainActionCurrentResultV1",
  "description": "Reference-free owner-current result shell for public action progress.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "state": { "enum": ["changed", "already_current", "processed_but_unavailable"] },
    "safe_reason": { "$ref": "scenario-safe-reason-v1.schema.json" }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": { "state": { "enum": ["changed", "already_current"] } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "safe_reason"],
      "properties": {
        "state": { "const": "processed_but_unavailable" },
        "safe_reason": { "$ref": "scenario-safe-reason-v1.schema.json" }
      }
    }
  ]
}
