{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morethan.local/contracts/integration-lock-v3.schema.json",
  "title": "IntegrationLockV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["lock_version", "generated_at", "scenario_key", "qualification_mode", "base_contract", "host_sdk", "scenario_artifact"],
  "properties": {
    "lock_version": { "const": 3 },
    "generated_at": { "type": "string", "format": "date-time" },
    "scenario_key": { "type": "string", "minLength": 1 },
    "qualification_mode": { "enum": ["ordinary", "joint_candidate"] },
    "base_contract": { "$ref": "#/$defs/revision" },
    "host_sdk": { "$ref": "#/$defs/revision" },
    "scenario_artifact": { "$ref": "#/$defs/revision" }
  },
  "$defs": {
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "logical_paths", "hash_algorithm", "source_hash"],
      "oneOf": [
        { "properties": { "source": { "const": "git" } }, "required": ["repository", "revision"] },
        { "properties": { "source": { "const": "package" } }, "required": ["package", "version", "artifact_path"] }
      ],
      "properties": {
        "source": { "enum": ["git", "package"] },
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": "string", "minLength": 1 },
        "logical_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "hash_algorithm": { "const": "sha256-path-content-source-hash-normalized-v1" },
        "source_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
