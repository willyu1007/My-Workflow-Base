  "state": {
    "meta": {
      "source": "The reference expresses these as concrete CSS on .mt-btn and friends rather than as tokens; the values are adopted verbatim and only the encoding is new.",
      "not_emitted_to_css": "Only the leaves listed under `css` become custom properties — today that is disabled.opacity, which components.css consumes in four places. pressed and hover stay structural: the reference expresses them as a transform and a color-mix() inside component rules, and converting those is a refactor rather than a token emission. They are recorded here so a native kit does not re-derive them.",
      "hover_note": "mix_percent is the surviving portion of the base color in color-mix(in oklab, base <pct>%, white). Touch platforms have no hover; the value exists so web and native share one definition rather than diverging.",
      "disabled_unification": "components.css carried 0.5 on two surfaces and 0.55 on two others. Owner decided 2026-08-01 to unify on 0.5, the reference value; all four now read the emitted variable so the split cannot silently return. See DECISIONS.md D-A9."
    },
    "pressed": {
      "scale": 0.99,
      "translate_y": "0.5px",
      "shadow": "xs"
    },
    "disabled": {
      "opacity": 0.5
    },
    "hover": {
      "mix_percent": 92
    },
    "css": {
      "--state-disabled-opacity": "disabled.opacity"
    }
  }
