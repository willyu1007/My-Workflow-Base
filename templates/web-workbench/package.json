{
  "name": "@willyu1007/web-workbench",
  "version": "0.14.1",
  "type": "module",
  "description": "Scenario-agnostic web workbench UI kit (Scene paradigms) — contracts + presentational React components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willyu1007/My-Workflow-Base.git",
    "directory": "templates/web-workbench"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./brand": {
      "types": "./dist/brand.d.ts",
      "default": "./dist/brand.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "default": "./dist/primitives.js"
    },
    "./shell": {
      "types": "./dist/shell.d.ts",
      "default": "./dist/shell.js"
    },
    "./feedback": {
      "types": "./dist/feedback.d.ts",
      "default": "./dist/feedback.js"
    },
    "./list": {
      "types": "./dist/list.d.ts",
      "default": "./dist/list.js"
    },
    "./insight": {
      "types": "./dist/insight.d.ts",
      "default": "./dist/insight.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "default": "./dist/settings.js"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "default": "./dist/form.js"
    },
    "./hub": {
      "types": "./dist/hub.d.ts",
      "default": "./dist/hub.js"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "default": "./dist/queue.js"
    },
    "./record": {
      "types": "./dist/record.d.ts",
      "default": "./dist/record.js"
    },
    "./styles": "./dist/styles/index.css",
    "./styles/*": "./dist/styles/*",
    "./stylelint": "./dist/lint/stylelint.cjs",
    "./eslint": "./dist/lint/eslint.js",
    "./lint-debt": "./dist/lint/design-debt.mjs"
  },
  "files": [
    "dist",
    "*.md"
  ],
  "scripts": {
    "tokens": "node tokens/emit.mjs",
    "tokens:check": "node tokens/emit.mjs --check",
    "build": "pnpm tokens:check && tsc -p tsconfig.build.json && mkdir -p dist/styles && cp src/styles/*.css dist/styles/ && mkdir -p dist/lint && cp lint/stylelint.cjs lint/eslint.js lint/design-debt.mjs dist/lint/",
    "build:css": "mkdir -p dist/styles && cp src/styles/*.css dist/styles/",
    "build:lint": "mkdir -p dist/lint && cp lint/stylelint.cjs lint/eslint.js lint/design-debt.mjs dist/lint/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "next": "^16",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
