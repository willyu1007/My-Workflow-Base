{
  "name": "@host/scenario-module-example",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "federation-descriptor.json",
    "prisma",
    "integration-lock.example.json"
  ],
  "scripts": {
    "build": "pnpm prisma:generate && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "typecheck": "pnpm prisma:generate && tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests --exclude tests/prisma-owner-api.integration.test.ts",
    "test:db": "pnpm prisma:generate && vitest run tests/prisma-owner-api.integration.test.ts"
  },
  "dependencies": {
    "@host/workflow-contracts": "workspace:*",
    "@prisma/client": "6.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "prisma": "6.19.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.5"
  }
}
