generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ExampleRecord {
  id        String   @id @default(cuid())
  version   Int      @default(1)
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScenarioCommandExecution {
  id                  String   @id @default(cuid())
  scenarioKey         String
  commandId           String   @unique
  idempotencyKey      String
  commandEnvelope     Json
  workflowRunRef      Json
  workflowStepRef     Json
  commandIdentityHash String
  status              String
  receipt             Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([scenarioKey, idempotencyKey])
  @@index([scenarioKey, status, createdAt])
}

model OwnerIntegrationOutbox {
  id                 String   @id @default(cuid())
  scenarioKey        String
  eventId            String   @unique
  eventType          String
  eventSchemaVersion Int
  scenarioRelease    Json
  ownerEventRef      Json
  subjectRefs        Json
  actorRef           Json
  purpose            String
  correlationId      String
  traceId            String?
  occurredAt         DateTime
  dispatchedAt       DateTime?
  attemptCount       Int      @default(0)
  nextAttemptAt      DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([scenarioKey, dispatchedAt, nextAttemptAt])
}

model OwnerIntegrationInbox {
  id                 String   @id @default(cuid())
  scenarioKey        String
  hostEventId        String   @unique
  hostEventType      String
  eventSchemaVersion Int
  scenarioRelease    Json
  ownerEventRef      Json
  subjectRefs        Json
  actorRef           Json
  ownerTargetRef     Json
  purpose            String
  correlationId      String
  traceId            String?
  occurredAt         DateTime
  receivedAt         DateTime @default(now())
  processedAt        DateTime?
  failureCode        String?
  attemptCount       Int      @default(0)
  nextAttemptAt      DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([scenarioKey, processedAt, nextAttemptAt])
}
